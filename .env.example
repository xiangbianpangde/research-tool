# research-tool 环境变量模板
# 本文件仅作参考；本地 .env 可由 research setup 或 python scripts/setup_interactive.py 生成/更新
# 切勿提交真实密钥到 git

# ========== LLM（报告/知识树，与 provider 对应至少配一个）==========
# 交互向导会同时更新这三个身份字段，避免旧 provider/endpoint/key 混用。
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_SESSION_ID=              # 可选网关会话路由（x-opencode-session）
# LLM_API_KEY=                 # provider=openai_compatible 时使用，须同时指定 model/base_url
# RESEARCH_CONFIG=             # 可选 YAML 配置路径
# RESEARCH_WORK_DIR=            # 可选默认输出目录
# RESEARCH_HOME=                # 可选非源码安装的本地状态目录
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=             # 可选视频转写端点
# MINIMAX_OPENAI_BASE_URL=      # 上项未设时使用的 MiniMax 兼容端点

# ========== GitHub（强烈建议）==========
# Classic PAT: https://github.com/settings/tokens
# 权限：可不勾任何 scope（公开搜索+配额+公开 code search）
# GITHUB_TOKEN=

# ========== 搜索 ==========
# Tavily: https://app.tavily.com  → -s tavily
# TAVILY_API_KEY=
# Semantic Scholar: https://www.semanticscholar.org/product/api  → -s semantic_scholar
# S2_API_KEY=
# OpenAlex polite pool（邮箱字符串，不是 token）
# OPENALEX_MAILTO=you@example.com

# ========== 代理（国内被墙源；海外请留空）==========
# HTTPS_PROXY=
# HTTP_PROXY=
# YTDLP_PROXY=

# ========== 视频转写（默认 MiniMax-M3 多模态）==========
# 使用上方 MINIMAX_API_KEY；协议兼容不代表跨厂商凭据兼容。
# GROQ_API_KEY=   # 可选 fallback（whisper 云）

# ========== X / Twitter ==========
# 默认 x_backend=opencli：cookie 由 opencli 自动从浏览器取，勿手填。
# 不要在此文件写入 cookie、token 或真实凭据。
# 仅 twitter-cli 需要：
# TWITTER_AUTH_TOKEN=
# TWITTER_CT0=
